    "diff": "^9.0.0",
    "openai": "^7.60.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "author": "Muhammet Ali AKBAY",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/m-ali-akbay/md-code.git"
  },
  "homepage": "https://github.com/m-ali-akbay/md-code#readme",
  "keywords": [
    "markdown",
    "llm",
    "compiler",
    "codegen",
